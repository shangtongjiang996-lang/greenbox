# GreenBox 环境变量模板
# 复制为 .env 后填入真实值，不要提交 .env。
# 在 InstaBox 机器上可用 scripts/start-instabox.sh 启动，它会优先读取 .env。

NODE_ENV=production
PORT=3000

# Redis：必须是 InstaBox 能访问的外部地址
REDIS_URL=rediss://default:password@host:6379

# 智谱 API Key
ZHIPU_API_KEY=

# Backblaze B2（B2_ENDPOINT 不要带 https://）
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=Greenboxwebdata

# 仅在 Redis 还没有管理员密码时使用
ADMIN=
